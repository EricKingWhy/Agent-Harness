# intelligence-agent 运行配置模板
# 复制为 .env 后填写。.env 绝不能提交进仓库。

# ── 必填：模型 ────────────────────────────────────────────────
# MODEL_PROVIDER 是「模型家族预设」的 key，只决定默认 base_url 与能力位
# （supports_tools / context_window 等），可选值：deepseek / qwen / tencent /
# senseaudio / zhipu。未知值会在启动期响亮报错，不会拖到首次请求才失败。
# 真实请求网关由 MODEL_BASE_URL 显式覆盖 —— 所以用聚合网关/自建端点时，
# provider 填最贴近模型家族的预设，base_url 填真实端点即可。
MODEL_PROVIDER=deepseek
MODEL_NAME=deepseek-v4-pro
MODEL_BASE_URL=https://api.openai-next.com/v1
MODEL_API_KEY=sk-在这里填你的模型 API Key
TEMPERATURE=0.2

# 官方端点示例（改成对应 provider + 删掉 MODEL_BASE_URL 即可）：
#   deepseek 官方 : MODEL_PROVIDER=deepseek  MODEL_NAME=deepseek-chat
#   senseaudio   : MODEL_PROVIDER=senseaudio MODEL_NAME=deepseek-v4-flash-0731
#                  MODEL_BASE_URL=https://api.senseaudio.cn/v1
#   zhipu BigModel: MODEL_PROVIDER=zhipu    MODEL_NAME=glm-4.5-air

# ── 可选：会话级模型切换（前端「模型」选择器的数据源，JSON 数组）──
# 条目不写 api_key 时回落 MODEL_API_KEY；不写 base_url 时回落 provider 预设。
# 走第三方网关时，每条【必须】显式写 base_url，否则会回落到预设网关而 401/404。
AGENT_MODELS=[{"name": "deepseek-v4-flash", "provider": "deepseek", "model_name": "deepseek-v4-flash", "base_url": "https://api.openai-next.com/v1"}, {"name": "glm-5.3", "provider": "zhipu", "model_name": "glm-5.3", "base_url": "https://api.openai-next.com/v1"}]

# ── 可选：能力开关（JSON，缺省 {} = 全部不启用，Core 照常运行）──
# websearch 需要 TAVILY_API_KEY；未配置则该能力缺席，不阻塞主流程。
CAPABILITIES={"websearch": {"provider": "builtin", "enabled": true, "options": {}}, "multiagent": {"provider": "builtin", "enabled": true, "options": {}}}
TAVILY_API_KEY=

# ── 可选：稳定性 ─────────────────────────────────────────────
LOG_LEVEL=INFO
MODEL_MAX_CONCURRENCY=2
APPROVAL_TIMEOUT_SECONDS=180
RUN_DISCONNECT_GRACE_SECONDS=120

# ── 可选：公网部署的自检端点令牌 ──────────────────────────────
# serve.py 的 /__netprobe /__selftest /__logs 用 ?t=<此令牌> 鉴权
# （/__deploy_info 故意不鉴权，方便裸打排查）。留空 = 这三个端点直接拒绝。
DEMO_PROBE_TOKEN=

# ── 可选：运行时目录（默认 ./.agent/workspace）───────────────
# 会话事件 JSONL、工作区、harness.db 都在这里
# WORKSPACE_DIR=.agent/workspace
