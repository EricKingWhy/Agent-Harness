# intelligence-agent 运行配置模板
# 复制为 .env 后填写。.env 绝不能提交进仓库。

# ── 必填：模型 ────────────────────────────────────────────────
MODEL_PROVIDER=senseaudio
MODEL_NAME=deepseek-v4-flash-0731
MODEL_BASE_URL=https://api.senseaudio.cn/v1
MODEL_API_KEY=sk-在这里填你的模型 API Key
TEMPERATURE=0.2

# ── 可选：会话级模型切换（前端「模型」选择器的数据源，JSON 数组）──
# 条目不写 api_key 时回落 MODEL_API_KEY；不写 base_url 时回落 provider 预设。
AGENT_MODELS=[{"name":"glm-5.3-flash","provider":"senseaudio","model_name":"glm-5.3-flash"}]

# ── 可选：能力开关（JSON，缺省 {} = 全部不启用，Core 照常运行）──
# websearch 需要 TAVILY_API_KEY；未配置则该能力缺席，不阻塞主流程。
CAPABILITIES={"websearch": {"provider": "builtin", "enabled": true, "options": {}}, "multiagent": {"provider": "builtin", "enabled": true, "options": {}}}
TAVILY_API_KEY=

# ── 可选：稳定性 ─────────────────────────────────────────────
LOG_LEVEL=INFO
MODEL_MAX_CONCURRENCY=2
APPROVAL_TIMEOUT_SECONDS=180
RUN_DISCONNECT_GRACE_SECONDS=120

# ── 可选：运行时目录（默认 ./.agent/workspace）───────────────
# 会话事件 JSONL、工作区、harness.db 都在这里
# WORKSPACE_DIR=.agent/workspace
